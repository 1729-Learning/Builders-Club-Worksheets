# Builders Club Worksheets — environment variables.
# Copy the ones you need into Railway (Variables tab) or a local .env file.
# Paste values RAW — no surrounding quotes.

# ---- Railway sets these automatically; do not set them by hand ----
# PORT                          HTTP port.
# RAILWAY_VOLUME_MOUNT_PATH     Set when a Volume is attached (e.g. /data).
# RAILWAY_PUBLIC_DOMAIN         Your service's domain; PUBLIC_BASE_URL is derived from it.

# ---- Sign-in: Microsoft account ----
# Application (client) ID from your app registration's Overview page.
MS_CLIENT_ID=
# The client secret VALUE from Certificates & secrets (not the Secret ID).
MS_CLIENT_SECRET=
# OPTIONAL. Leave EMPTY for multi-tenant: any Microsoft account can sign in —
# school or personal — and no other organization has to configure anything.
# Set it to a Directory (tenant) ID to restrict sign-in to that one directory.
MS_TENANT_ID=
# Comma-separated emails that get the student roster. Case-insensitive,
# re-read on every request, so adding one takes effect without a redeploy.
INSTRUCTOR_EMAILS=
# OPTIONAL. Comma-separated email domains allowed to sign in, e.g.
# school.edu,gmail.com — a listed domain also covers its subdomains.
# Empty (the default) lets any Microsoft account in. Worth setting if you don't
# want strangers creating accounts and spending your AI budget.
ALLOWED_EMAIL_DOMAINS=

# ---- Required ----
# Signs session cookies. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=
# How many days a sign-in lasts.
SESSION_DAYS=30
# Public https origin. On Railway this comes from RAILWAY_PUBLIC_DOMAIN
# automatically — set it only for a custom domain.
PUBLIC_BASE_URL=

# ---- AI reviewer (set at least one key) ----
# Enables the Claude engine.
ANTHROPIC_API_KEY=
# Enables the Codex (OpenAI) engine.
OPENAI_API_KEY=
# Default engine: claude | codex | auto. Students can switch only when BOTH keys are set.
REVIEW_BACKEND=claude
# Anthropic model used for reviews and drafts.
REVIEW_MODEL=claude-sonnet-5
# OpenAI model used when the Codex engine is active.
OPENAI_MODEL=gpt-5.6-terra
# Output token ceilings. Reviews stream, so a high ceiling is safe.
REVIEW_MAX_TOKENS=32000
DRAFT_MAX_TOKENS=16000
# Per-request timeout in milliseconds.
AI_TIMEOUT_MS=300000
# Max simultaneous AI calls across all students.
AI_CONCURRENCY=4
# Max AI calls per student per day (reviews + drafts). 0 disables the cap.
REVIEW_DAILY_CAP=60

# ---- Storage ----
# Where per-student JSON lives. Defaults to RAILWAY_VOLUME_MOUNT_PATH, then ./data.
DATA_DIR=

# ---- Local development only ----
# 1 enables GET /auth/dev?as=<name> (fake sign-in). Ignored once MS_CLIENT_ID is
# set, in production, and on Railway — it can never be reached on a deploy.
ALLOW_DEV_LOGIN=0
