# Builders Club Worksheets — environment variables.
# Copy the ones you need into Railway (Variables tab) or a local .env file.

# ---- Railway sets these automatically; do not set them by hand ----
# PORT                          HTTP port. Railway injects it; defaults to 4321 locally.
# RAILWAY_VOLUME_MOUNT_PATH     Set by Railway when a Volume is attached (e.g. /data).

# ---- Required in production ----
# Public https origin of the site. The Microsoft redirect URI is ${PUBLIC_BASE_URL}/auth/callback
PUBLIC_BASE_URL=https://worksheets.example.up.railway.app
# Long random string used to sign session cookies. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=
# How many days a sign-in lasts before students must sign in again.
SESSION_DAYS=30

# ---- Microsoft sign-in (Entra ID app registration) ----
# Directory (tenant) ID — single tenant, so only your school's accounts can sign in.
MS_TENANT_ID=
# Application (client) ID from the app registration Overview page.
MS_CLIENT_ID=
# Client secret VALUE (not the secret ID) from Certificates & secrets.
MS_CLIENT_SECRET=
# Comma-separated school emails that get the instructor roster. Case-insensitive.
INSTRUCTOR_EMAILS=

# ---- AI reviewer (set at least one key) ----
# Enables the Claude engine.
ANTHROPIC_API_KEY=
# Enables the Codex (OpenAI) engine.
OPENAI_API_KEY=
# Default engine: claude | codex | auto. Students can switch only when BOTH keys are set.
REVIEW_BACKEND=claude
# Anthropic model used for reviews and drafts.
REVIEW_MODEL=claude-sonnet-5
# OpenAI model used when the Codex engine is active.
OPENAI_MODEL=gpt-5.6-terra
# Output token ceilings. Reviews stream, so a high ceiling is safe.
REVIEW_MAX_TOKENS=32000
DRAFT_MAX_TOKENS=16000
# Per-request timeout in milliseconds.
AI_TIMEOUT_MS=300000
# Max simultaneous AI calls across all students.
AI_CONCURRENCY=4
# Max AI calls per student per day (reviews + drafts). 0 disables the cap.
REVIEW_DAILY_CAP=60

# ---- Storage ----
# Where per-student JSON lives. Defaults to RAILWAY_VOLUME_MOUNT_PATH, then ./data locally.
DATA_DIR=

# ---- Local development only ----
# 1 enables GET /auth/dev?as=<name> (fake sign-in). NEVER set this in production.
ALLOW_DEV_LOGIN=0
